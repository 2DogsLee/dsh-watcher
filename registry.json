{
  "_comment": "dsh-api-watch 插件注册表（仓库示例）。真实使用请复制为 registry.local.json（已在 .gitignore，不会被提交），脚本会优先读取它。uses.packages 填官方仓库路径（如 packages/preset/persona），不是 npm 包名；前缀匹配，写太宽会淹没。生成方式见 docs/local-setup.md 第 2 节。",
  "version": 1,
  "plugins": [
    {
      "name": "example-my-preset",
      "kind": "declaration",
      "repo": "https://github.com/you/my-preset",
      "uses": {
        "packages": [
          "packages/preset/persona",
          "packages/preset/agent-preset",
          "packages/context/agent-instructions",
          "packages/tool/bash",
          "packages/tool/pwsh",
          "packages/subagent/tool-subagent",
          "packages/subagent/tool-subagent-control"
        ],
        "config": [
          "@deepseek-ai/dsh-persona",
          "@deepseek-ai/dsh-agent-instructions",
          "@deepseek-ai/dsh-tool-subagent"
        ],
        "docs": ["docs/cordis-api", "docs/subsystems"],
        "keywords": ["preset", "persona", "subagent"]
      }
    },
    {
      "name": "example-my-client-plugin",
      "repo": "https://github.com/you/my-plugin",
      "uses": {
        "packages": ["packages/client/ui-primitives", "packages/client/modules"],
        "config": [],
        "docs": [],
        "keywords": ["client", "plugin"]
      }
    }
  ]
}
